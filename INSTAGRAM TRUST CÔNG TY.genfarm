thư mục bạn muốn kiểm tra\nconst folderPath = await genfarmerGetVariable('folder_image');\n\n// Danh sách đuôi mở rộng của ảnh phổ biến\nconst imageExtensions = [\n  '.jpg', '.jpeg', '.png', '.gif', '.bmp', '.tiff', '.webp', '.svg'\n];\n\ntry {\n  // Đọc tất cả file trong thư mục\n  const files = fs.readdirSync(folderPath);\n\n  // Lọc ra các file có đuôi là ảnh\n  const imageFiles = files.filter(file => {\n    const ext = path.extname(file).toLowerCase();\n    return imageExtensions.includes(ext);\n  });\n\n  // Tạo mảng chứa đường dẫn đầy đủ tới các file ảnh\n  const imageArray = imageFiles.map(file => path.join(folderPath, file));\n\n  const randomIndexxxx = Math.floor(Math.random() * imageArray.length);\n\nconst randomElementttt = imageArray[randomIndexxxx];\n\n  // In ra kết quả\n  console.log('Các file ảnh tìm thấy:');\n  await genfarmerSetVariable('url_img', randomIndexxxx); // Đặt tên biến là list_image\n  console.log(imageArray);\n} catch (err) {\n  console.error('Đã xảy ra lỗi:', err.message);\n}"},"successNode":"EljIJ","failNode":null},"label":"Javascript","sourcePosition":"right","targetPosition":"left","class":""},{"id":"EljIJ","type":"custom","position":{"x":-3875.5763574689395,"y":1297.2454546110937},"data":{"icon":"file","action":"Log","options":{"disabled":false,"nodeSleep":"0","nodeTimeout":"120","timeoutNextNode":"successNode","breakpoint":false,"timeoutAdbReconnect":"60","nodeLog":"","log":"${arr_image}"},"successNode":"ZRDn8","failNode":null},"label":"Log","sourcePosition":"right","targetPosition":"left","class":""},{"id":"qN4qu","type":"custom","position":{"x":-3874.0386012159297,"y":1029.4692278576815},"data":{"icon":"helpCircle","action":"If","options":{"disabled":false,"nodeSleep":"0","nodeTimeout":"120","timeoutNextNode":"successNode","breakpoint":false,"timeoutAdbReconnect":"60","nodeLog":"","leftOperand":"AI_gen_img","rightOperand":"1","operator":"="},"successNode":"UAypW","failNode":"o78zU"},"label":"If","sourcePosition":"right","targetP