sition":"left","class":""},{"id":"fPJe5","type":"custom","position":{"x":-4232.269428649415,"y":1298.0354967344256},"data":{"icon":"actionEval","action":"Javascript","options":{"disabled":false,"nodeSleep":"0","nodeTimeout":"120","timeoutNextNode":"successNode","breakpoint":false,"timeoutAdbReconnect":"60","nodeLog":"","script":"const fs = require('fs');\nconst path = require('path');\n\n// Đường dẫn thư mục bạn muốn kiểm tra\nconst folderPath = await genfarmerGetVariable('folder_image');\n\n// Danh sách đuôi mở rộng của ảnh phổ biến\nconst imageExtensions = [\n  '.jpg', '.jpeg', '.png', '.gif', '.bmp', '.tiff', '.webp', '.svg'\n];\n\n// Hàm để tìm kiếm các file ảnh\nfunction findImageFiles(folderPath, imageExtensions) {\n  try {\n    const files = fs.readdirSync(folderPath);\n    const imageFiles = files.filter(file => {\n      const ext = path.extname(file).toLowerCase();\n      return imageExtensions.includes(ext);\n    });\n    return imageFiles.map(file => path.join(folderPath, file));\n  } catch (err) {\n    console.error('Đã xảy ra lỗi:', err.message);\n    return []; // Trả về một mảng rỗng nếu có lỗi\n  }\n}\n\n// Hàm lấy một phần tử ngẫu nhiên từ mảng\nfunction getRandomElement(array) {\n  if (array.length === 0) {\n    return null; // Trả về null nếu mảng rỗng\n  }\n  const randomIndex = Math.floor(Math.random() * array.length);\n  return array[randomIndex];\n}\n\ntry {\n  // Tìm file ảnh\n  const imageArray = findImageFiles(folderPath, imageExtensions);\n\n  // Lấy một đường dẫn ngẫu nhiên\n  const randomPath = getRandomElement(imageArray);\n\n  // In ra kết quả\n  console.log('Đường dẫn ảnh ngẫu nhiên:');\n  await genfarmerSetVariable('url_img', randomPath); // Lưu đường dẫn ngẫu nhiên vào biến random_media_path\n  console.log(randomPath);\n\n} catch (err) {\n  console.error('Đã xảy ra lỗi:', err.message);\n}"},"successNode":"ul8RV","failNode":null},"label":"Javascript","sourcePosition":"right","targetPosition":"left","class":""},{"id":"ul8RV","type":"custom","position":{"x":-4079.769428649415,"y":1435.5354967344256},"data":{"icon":"file","action":"Log","options":{"disabled":false,"nodeSleep":"0","nodeTimeout":"120","timeoutNextNode":"successNode","breakpoint":false,"timeoutAdbReconnect":"60","nodeLog":"","log":"link được chọn : ${url_img}"},"successNode":"KXJ6n","failNode":null},"label":"Log","sourcePosition":"right","targetPosition":"left","class":""},{"id":"mSFrr","type":"custom","position":{"x":-1985.5942481692468,"y":2029.1077491395095},"data":{"icon":"actionPress","action":"Press","options":{"disabled":false,"nodeSleep":"0","nodeTimeout":"120","timeoutNextNode":"successNode","breakpoint":false,"timeoutAdbReconnect":"60","nodeLog":"","key":"67"},"successNode":"2yOf3","failNode":null},"label":"Press key","sourcePosition":"right","targetPosition":"left","class":""},{"id":"2yOf3","type":"custom","position":{"x":-1982.3068801138386,"y":2131.221389844598},"data":{"icon":"actionBreak","action":"Break","options":{"disabled":false,"nodeSleep":"0","nodeTimeout":"120","timeoutNextNode":"successNode","breakpoint":false,"timeoutAdbReconnect":"60","nodeLog":"","loopId":"IDliop","stopLoop":false},"successNode":"XxgiL","failNode":null},"label":"Break Loop","sourcePosition":"right","targetPosition":"left","class":""},{"id":"_43QL","type":"custom","position":{"x":-1985.6594774006294,"y":1936.5385850887178},"data":{"icon":"actionLoop","action":"LoopV2","options":{"disabled":false,"nodeSleep":"0","nodeTimeout":"120","timeoutNextNode":"successNode","breakpoint":false,"timeoutAdbReconnect":"60","nodeLog":"","loopType":"For","forFrom":"1","forTo":"200","forEachFrom":"","forEachValue":"","whileLeftOperand":"","whileOperator":null,"whileRightperand":"","loopId":"IDliop","spreadSheetRefKey":""},"successNode":"mSFrr","failNode":null},"label":"Loop V2","sourcePosition":"right","targetPosition":"left","class":""},{"id":"Nxphi","type":"custom","position":{"x":-2147.2609148359134,"y":1895.7744158061762},"data":{"icon":"actionPause","action":"Pause","options":{"disabled":false,"nodeSleep":"0","nodeTimeout":"0","timeoutNextNode":"successNode","breakpoint":false,"timeoutAdbReconnect":"60","nodeLog":"","timeoutType":"fixed","timeout":"2","timeoutFrom":"1","timeoutTo":"3"},"successNode":"_43QL","failNode":null},"label":"Sleep","sourcePosition":"right","targetPosition":"left","class":""},{"id":"JiqVV","type":"custom","position":{"x":-880.2791771236941,"y":408.91676245004186},"data":{"icon":"actionEval","action":"Javascript","options":{"disabled":false,"nodeSleep":"0","nodeTimeout":"120","timeoutNextNode":"successNode","breakpoint":false,"timeoutAdbReconnect":"60","nodeLog":"","script":"let keygpt_list = await genfarmerGetVariable(\"List_api\");\n\n// Tách thành mảng\nlet apiKeys = keygpt_list.split(\"\\n\");\n\n\nfor (let i = 0; i < 10; i++) {\n  if (apiKeys.length === 0) break;\n\n  // Lấy random 1 key\n  let randomIndex = Math.floor(Math.random() * apiKeys.length);\n  let key = apiKeys[randomIndex];\n\n  try {\n    // Gọi API check tới Gemini 2.0 Flash\n    let res = await fetch(\n      \"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent?key=\" + key,\n      {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({\n          contents: [\n            { parts: [ { text: \"ping\" } ] }\n          ]\n        })\n      }\n    );\n\n    if (res.status === 200) {\n      // Lưu key sống\n      await genfarmerSetVariable(\"Api_key\", key);\n      console.log(\"✅ Key hoạt động:\", key);\n      break; // dừng vòng lặp vì đã tìm được key hợp lệ\n    } else {\n      console.log(\"❌ Key lỗi:\", key, \"status:\", res.status);\n      // Xoá key die\n      apiKeys.splice(randomIndex, 1);\n    }\n\n  } catch (err) {\n    console.error(\"⚠️ Lỗi gọi API với key:\", key, err);\n    apiKeys.splice(randomIndex, 1);\n  }\n}\n"},"successNode":null,"failNode":null},"label":"Javascript","sourcePosition":"right","targetPosition":"left","class":""},{"id":"3n4Jm","type":"custom","position":{"x":-1397.8542361968482,"y":205.36467635701797},"data":{"icon":"actionVariables","action":"SetVariable","options":{"disabled":false,"nodeSleep":"0","nodeTimeout":"120","timeoutNextNode":"successNode","breakpoint":false,"timeoutAdbReconnect":"60","nodeLog":"","variableName":"var_Key_word","setOperator":"=","variableValue":"${Chu_de}"},"successNode":"7iQIh","failNode":null},"label":"Set variable","sourcePosition":"right","targetPosition":"left","class":""},{"id":"yVClE","type":"custom","position":{"x":-60.61818784408615,"y":-981.9096164411334},"data":{"icon":"actionPress","action":"Press","options":{"disabled":false,"nodeSleep":"0","nodeTimeout":"120","timeoutNextNode":"successNode","breakpoint":false,"timeoutAdbReconnect":"60","nodeLog":"","key":"4"},"successNode":"PNqvF","failNode":null},"label":"Press key","sourcePosition":"right","targetPosition":"left","class":""},{"id":"PNqvF","type":"custom","position":{"x":74.38181215591385,"y":-944.4096164411333},"data":{"icon":"actionPause","action":"Pause","options":{"disabled":false,"nodeSleep":"0","nodeTimeout":"0","timeoutNextNode":"successNode","breakpoint":false,"timeoutAdbReconnect":"60","nodeLog":"","timeoutType":"fixed","timeout":"2","timeoutFrom":"1","timeoutTo":"3"},"successNode":"qn8tI","failNode":null},"label":"Sleep","sourcePosition":"right","targetPosition":"left","class":""},{"id":"qn8tI","type":"custom","position":{"x":125.63181215591385,"y":-996.9096164411335},"data":{"icon":"actionMouseMove","action":"Touch","options":{"disabled":false,"nodeSleep":"0","nodeTimeout":"120","timeoutNextNode":"successNode","breakpoint":false,"timeoutAdbReconnect":"60","nodeLog":"","selectorBy":"selector","touchType":"normal","selector":"","x":"","y":"","touchCount":"1","delay":"","timeout":"10","xpath":"//*[@content-desc=\"Post\"]"},"successNode":"KeaNz","failNode":"W8RfU"},"label":"Touch","sourcePosition":"right","targetPosition":"left","class":""},{"id":"P4Scx","